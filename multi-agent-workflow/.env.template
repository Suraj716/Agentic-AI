# Multi-Agent Workflow Configuration Template
# Copy this file to .env and update the values for your environment

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
MAX_TOKENS=1500

# LLM Agent Configuration  
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama2

# MCP Agent Configuration
GRAFANA_URL=http://b18-vms-vm1063.cisco.com:3000
GRAFANA_API_KEY=your_grafana_api_key_here
PROMETHEUS_URL=http://b18-vms-vm1063.cisco.com:9090

# Agent Settings
LOG_LEVEL=INFO
ENABLE_QUERY_LOGGING=true
QUERY_HISTORY_PATH=./query_history.json
CACHE_DURATION_MINUTES=5

# MCP Configuration
MCP_ENABLED=true
MCP_PORT=8080
MCP_HOST=localhost

# Multi-Agent Workflow Settings
SUPERVISOR_ENABLED=true
SUPERVISOR_TIMEOUT=120
CONVERSATION_MEMORY_MAX=10
ENABLE_FOLLOW_UP_SUGGESTIONS=true

# Agent Routing Configuration
DEFAULT_AGENT=GeneralChat
ENABLE_LLM_ROUTING=true
ROUTING_TIMEOUT=10

# UI Configuration
STREAMLIT_PORT=8501
UI_TIMEOUT=120

# Monitoring Integration
ENABLE_REAL_MCP=true
MCP_CLIENT_TIMEOUT=120
FALLBACK_TO_MOCK=false